      ],
      "notes": "Credential: Header Auth — Name: Authorization, Value: Bearer <WhatsApp Cloud API access token>.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v23.0/me/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ recipient: { id: $('Normalize messages').item.json.userId }, messaging_type: 'RESPONSE', message: { text: $json.reply.slice(0, 1000) } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "af695f00-e8e6-5ee0-8d9e-d7e6d2a096e9",
      "name": "Reply on Messenger / Instagram",
