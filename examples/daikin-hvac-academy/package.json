{
  "name": "daikin-hvac-installation-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Independent HVAC installation training platform. Not affiliated with, endorsed by, or certified by Daikin Industries, Ltd.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test:pg": "TEST_DATABASE_URL=$TEST_DATABASE_URL vitest run",
    "keys": "node scripts/extract-keys.mjs",
    "db:seed:demo": "tsx --env-file=.env scripts/seed.ts --demo",
    "setup": "npm run db:migrate && npm run db:seed:demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
