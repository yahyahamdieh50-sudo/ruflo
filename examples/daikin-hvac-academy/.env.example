# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Long random string (>= 32 chars). Generate: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me
# PostgreSQL connection string
DATABASE_URL=postgres://academy:academy@localhost:5432/academy
# Set to "true" when the DB provider requires TLS (most managed Postgres)
DATABASE_SSL=false

# ── Bootstrap admin (used by `npm run db:seed`, change immediately) ─────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Now-123!

# ── Stripe (test keys first!) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: let Stripe Tax compute UAE VAT (requires Stripe Tax setup)
STRIPE_AUTOMATIC_TAX=false

# ── Email (SMTP). Without these, emails are logged to the console only ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Installation Academy <no-reply@example.com>"

# ── Private media storage ───────────────────────────────────────────────
# "local" streams from ./storage/private (dev / single server)
# "s3" uses S3-compatible storage (AWS S3, Cloudflare R2, ...) with signed URLs
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI training assistant (optional) ────────────────────────────────────
# Without a key the assistant returns matching approved passages only.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# ── Display ─────────────────────────────────────────────────────────────
# AED is pegged to USD at 3.6725; display-only, billing is always USD.
AED_PER_USD=3.6725
