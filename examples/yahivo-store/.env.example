# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is private: it is listed in .gitignore and must never be shared, committed or pasted into chat.

# Admin password for /admin (12+ characters)
ADMIN_PASSWORD=

# Ziina payments — create an API key in your Ziina business account.
ZIINA_API_TOKEN=
# Leave empty for TEST mode. Set to 1 only after a successful test payment.
ZIINA_LIVE=

# Public address once the store is online, e.g. https://shop.yahivo.com
SITE_URL=

# Optional: live AI shopping assistant
ANTHROPIC_API_KEY=
